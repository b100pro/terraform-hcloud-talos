# Hetzner Cloud API token
hcloud_token              = "your-hcloud-api-token"
cluster_name              = "tmain"
control_plane_count       = "3"
location                  = "fsn1"
control_plane_server_type = "cx23"
talos_version             = "1.12.0"
firewall_use_current_ip   = true
deploy_piraeus            = true
cilium_enable_encryption  = true

kernel_modules_to_load = [
  {
    name       = "drbd"
    parameters = ["usermode_helper=disabled"]
  },
  {
    name = "drbd_transport_tcp"
  },
  {
    name = "zfs"
  }
]

tailscale = {
  enabled      = true
  auth_key     = "your-preauth-key"                  # headscale preauthkeys create --user default
  login_server = "http://your-headscale-server:8080"
  routes       = ["10.0.16.0/20", "10.0.8.0/21"]     # Pod + Service CIDRs for full cluster access
  # Optional: Automatic cleanup of Headscale nodes on terraform destroy
  # Requires: curl, jq, and network access to Headscale API
  api_key            = "your-headscale-api-key"     # headscale apikeys create --expiration 365d
  user               = "default"                    # Headscale user/namespace
  cleanup_on_destroy = true
}

cloudflared = {
  enabled = true
  token   = "your-cloudflared-tunnel-token"
}
